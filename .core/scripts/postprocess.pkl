open module bark.scripts.Postprocess

extends "pkl:Command"

import "../sys/preprocess/PreprocessData.pkl" as PreprocessData
import "postprocess-data.pkl" as Data

/// Preprocess output (projection-meta.pkl), supplied by the entry point.
metadata: PreprocessData

/// The evaluated projection (projection.pkl), supplied by the entry point. Left as
/// `Any` and read lazily: it is not touched when preprocessing already failed.
projection: Any

local data = (Data) {
  metadataModule = module.metadata
  projectionModule = module.projection
}

options: Options

class Options {
  /// Write postprocess output to a file instead of stdout.
  @Flag {
    shortName = "o"
    metavar = "file"
    completionCandidates = "paths"
  }
  output: String? = null

  /// Emit postprocess output even when Bark validation errors are present.
  @BooleanFlag
  force: Boolean = false
}

local shouldEmit = data.result.errors.isEmpty || options.force

output {
  // When publication is blocked, expose only the clean structured result. This
  // avoids rendering (and therefore forcing) an invalid projection.
  value = if (shouldEmit) data else data.result
  text =
    if (options.output == null || !shouldEmit)
      super.text
    else
      ""

  files {
    when (options.output != null && shouldEmit) {
      ["\(options.output)"] {
        value = data
      }
    }
  }
}
