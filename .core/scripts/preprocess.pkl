open module bark.scripts.Preprocess

extends "pkl:Command"

import "preprocess-data.pkl" as Data


import "../sys/constants.pkl" as CFG
import "../sys/Errors.pkl" as Errors
import "../sys/preprocess/PreprocessData.pkl" as PreprocessData

import "pkl:reflect"
local PREPROCESS_SCHEMA_PATH = reflect.Module(PreprocessData).uri
local ERRORS_PATH = reflect.Module(Errors).uri

options: Options

class Options {
  /// Write generated projection metadata source to a file instead of stdout.
  @Flag {
    shortName = "o"
    metavar = "file"
    completionCandidates = "paths"
  }
  output: String? = null
}

// PcfRenderer intentionally omits class names. That is normally desirable,
// but `List(new { ... })` cannot recover its element parent when the rendered
// document is used as generated Pkl source. Render error constructors with an
// explicit parent so error-bearing metadata remains evaluable.
local renderedDataBody =
  output.renderer.renderDocument(new Dynamic {
    manifestIndex = Data.manifestIndex
    directoryPaths = Data.directoryPaths
  })

local renderedErrors =
  if (Data.preprocessErrors.isEmpty)
    "preprocessErrors = List()"
  else
    let (items = Data.preprocessErrors.map((error) -> renderError(error)).join(",\n"))
      "preprocessErrors = List(\n\(indent(items))\n)"

local renderedBody =
  """
  \(renderedDataBody.trim())
  \(renderedErrors)
  """.trim()

local function renderError(error: Errors.Error): String =
  """
  new Errors.Error {
  \(indent(output.renderer.renderDocument(error).trim()))
  }
  """.trim()

local function indent(text: String): String = "  \(text.replaceAll("\n", "\n  "))"

local generatedHeader =
  """
  // @generated by .bark/core/scripts/preprocess.pkl; do not edit.
  // Arguments:
  //   --output=\(options.output ?? "<stdout>")
  //   \(CFG.INCLUDE_PREFIX_ENV_VAR)=\(CFG.INCLUDE_PREFIX)
  """.trim()

local rendered =
  """
  \(generatedHeader)

  amends "\(PREPROCESS_SCHEMA_PATH)"

  import "\(ERRORS_PATH)" as Errors

  \(renderedBody)
  """.trim()

output {
  text = if (options.output == null) rendered else ""

  files {
    when (options.output != null) {
      ["\(options.output)"] {
        text = rendered
      }
    }
  }
}
