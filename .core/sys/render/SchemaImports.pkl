module bark.render.SchemaImports

import "../../Context.pkl" as Context
import "../GraphModel.pkl" as Sys
import "../constants.pkl" as CFG
import "../Util.pkl" as Util
import "Expr.pkl" as Expr

/// Returns the import alias that generated type references must also use.
const function moduleNameFromSchema(schema: Sys.Schema): String =
  Util.stem(schema.path)

function renderImports(ctx: Context, node: Sys.AnyNode, pathPrefix: String): String =
  collectSchemas(ctx, node).toMap().values.map((schema) ->
    Expr.importAs("\(pathPrefix)\(schema.path)", moduleNameFromSchema(schema))
  ).join("\n")

// Schema discovery and deduplication are implementation policy for the import
// renderer, rather than a general graph-query API.
local typealias SchemaID = String

// Identifies a schema by the file it resolves to, read through the context.
// Schema paths are relative to the .bark directory.
local function schemaId(ctx: Context, schema: Sys.Schema): SchemaID =
  let (path = "\(CFG.BARK_DIRNAME)/\(schema.path)")
  let (resource = ctx.readFile.apply(path))
    if (resource == null)
      throw("Schema file does not exist: \(path)")
    else
      resource.uri

local function collectSchemaListFromNodes(nodes: Mapping<String, Sys.AnyNode>): List<Sys.Schema> =
  new Listing<List<Sys.Schema>> {
    for (_, node in nodes) {
      collectSchemaList(node)
    }
  }.fold(List(), (acc, x) -> acc + x)

local function collectSchemaList(node: Sys.AnyNode): List<Sys.Schema> =
  if (node is Sys.TableNode)
    List(node._schema)

  else if (node is Sys.CollectionNode)
    collectSchemaList(node._entryNode)

  else if (node is Sys.IndexNode)
    List(node._schema)
    // Projection type renderer intentionally ignores index children.

  else if (node is Sys.DirNode)
    collectSchemaListFromNodes(node._nodes)

  else
    throw("Unrecognized node type: '\(node.type)'")

local function dedupeSchemas(ctx: Context, schemas: List<Sys.Schema>): List<Sys.Schema> =
  schemas.fold(List(), (acc, schema) ->
    if (acc.any((x) -> schemaId(ctx, x) == schemaId(ctx, schema)))
      acc
    else
      acc + List(schema)
  )

local function collectSchemas(ctx: Context, node: Sys.AnyNode): Mapping<SchemaID, Sys.Schema> =
  new Mapping<SchemaID, Sys.Schema> {
    for (schema in dedupeSchemas(ctx, collectSchemaList(node))) {
      [schemaId(ctx, schema)] = schema
    }
  }
