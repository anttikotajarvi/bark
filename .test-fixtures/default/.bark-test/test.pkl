amends "pkl:test"

import "modulepath:/.bark/core/generated/projection.pkl" as Projection
import "modulepath:/.bark/core/generated/projection-meta.pkl" as Metadata

local exitCode = (read?("prop:bark.testExitCode") ?? "1") as String
local stdoutPath = (read?("prop:bark.testStdoutPath") ?? "") as String
local stdoutText = if (stdoutPath == "") "" else read(stdoutPath).text

local defaultReceiptId = "018f4f55-0000-7000-9000-000000000101"
local fixtureReceiptId = "018f4f55-0000-7000-9000-00000000f101"

facts {
  ["generation succeeds"] {
    exitCode == "0"
    stdoutText.contains("Generated and validated projection")
  }

  ["projection uses main repo graph"] {
    Projection.company.name == "Bark LLC"
    Projection.lots.containsKey("L1")
    Projection.lots.containsKey("L2")
    Projection.archive.`by-year`.`2024`.containsKey("WINTER-BOX-2024")
  }

  ["fixtures are excluded from default run"] {
    Metadata.manifestIndex.containsKey(defaultReceiptId)
    !Metadata.manifestIndex.containsKey(fixtureReceiptId)
  }
}
