amends "pkl:test"

import "modulepath:/.bark/core/generated/projection-meta.pkl" as Metadata
import "modulepath:/.bark/core/scripts/postprocess-data.pkl" as Postprocess

local exitCode = (read?("prop:bark.testExitCode") ?? "0") as String

facts {
  ["generation carries preprocessing errors"] {
    exitCode == "0"
  }

  ["manifest target details are preprocessing metadata"] {
    Metadata.preprocessErrors.length == 1
    Metadata.preprocessErrors[0].code == "MANIFEST_TARGET_MISSING"
    Metadata.preprocessErrors[0].message.contains("Manifest target missing")
    Metadata.preprocessErrors[0].message.contains("lots/L1/receipt.pdf.manifest.pkl")
    Metadata.preprocessErrors[0].message.contains("lots/L1/receipt.pdf")
  }

  ["postprocess reports one aggregate preprocessing failure"] {
    Postprocess.result.errors.length == 1
    Postprocess.result.errors[0].code == "PREPROCESS_FAILED"
    Postprocess.result.errors[0].message.contains("1. MANIFEST_TARGET_MISSING")
    Postprocess.result.errors[0].message.contains("Manifest target missing")
    Postprocess.result.errors[0].message.contains("lots/L1/receipt.pdf.manifest.pkl")
    Postprocess.result.errors[0].message.contains("lots/L1/receipt.pdf")
  }
}
