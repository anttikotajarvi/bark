module bark.PathScope

import "constants.pkl" as Constants

function keepUserLocalPath(path: String): Boolean =
  !hasBarkSegment(path)

/// Whether a file belongs in the projection: not under .bark, and not named in `omittedFilenames`.
function keepProjectLocalPath(path: String, omittedFilenames: List<String>): Boolean =
  keepUserLocalPath(path) && !omittedFilenames.contains(path.split("/").last)

function keepDirectoryChild(
  path: List<String>, // might need this later
  name: String
): Boolean =
  name != Constants.BARK_DIRNAME

local function hasBarkSegment(path: String): Boolean =
  path == Constants.BARK_DIRNAME ||
    path.startsWith("\(Constants.BARK_DIRNAME)/") ||
    path.contains("/\(Constants.BARK_DIRNAME)/")
