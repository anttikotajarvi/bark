/// Parts shared by named initializers and per-role defaults.
open module bark.extensions.InitializerBase
import "pkl:json"


import "../GraphModel.pkl" as Sys
import "../Generic.pkl" as G
import "../io/PathResolver.pkl" as PathResolver
import "../../Config.pkl" as Config


prepare: Hook?

typealias Generated = FileOutput | Mapping<String, FileOutput>

/// A file target (tableEntry) must return a FileOutput; other roles a Mapping of
/// files relative to the target directory. Checked by `run`, not here: Pkl does
/// not check the return type of a function value.
generate: (InitializerContext) -> Generated

/// Calls `generate` for a target of the given role and checks the result against it.
function runFor(role: Sys.PathRole, ctx: InitializerContext): Generated(
  if (Sys.isFileRole(role)) this is FileOutput else this is Mapping
) = generate.apply(ctx)

class InitializerContext {
  /// What the initializer is running for: role, schema, name, matching initializers.
  pathInfo: PathResolver.PathInfo

  /// Bark configuration of the data repo.
  config: Config

  input: String
  /// Parse input as JSON when needed.
  function parseJson(): Any =
    new json.Parser {
      useMapping = true
    }.parse(input)
}

class Hook {
  command: (InitializerContext) -> Command
  fingerprintDeps: List<String> = List()
}
class HookEvaluated {
  command: Command
  fingerprintDeps: List<String> = List()
}

class Command {
  args: List<String>
  env: G.Env = new Mapping {}
}
