module bark.extensions.Initializer

import "../GraphModel.pkl" as Sys


target: TargetKind

prepare: Hook?

typealias Generated = FileOutput | Mapping<String, FileOutput>

/// A file target (tableEntry) must return a FileOutput; other roles a Mapping of
/// files relative to the target directory. Checked by `run`, not here: Pkl does
/// not check the return type of a function value.
generate: (InitializerContext) -> Generated

/// Calls `generate` and checks its result against `target`.
function run(ctx: InitializerContext): Generated(
  if (Sys.isFileRole(target.role)) this is FileOutput else this is Mapping
) = generate.apply(ctx)

class InitializerContext {

}

class TargetKind {
  role: Sys.PathRole
  schema: Sys.Schema
}

class Hook {
  command: (InitializerContext) -> Command
  fingerprintDeps: List<String> = List()
}
class Command {
  args: List<String>
  env: Mapping<String, String> = new Mapping {}
}
