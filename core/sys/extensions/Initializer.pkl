/// An initializer for paths matching `target`, declared by name in the registry.
module bark.extensions.Initializer

extends "InitializerBase.pkl"

import "../GraphModel.pkl" as Sys

target: TargetKind

class TargetKind {
  role: Sys.PathRole
  schema: Sys.Schema
}

/// Calls `generate` and checks its result against `target`.
function run(ctx: InitializerContext): Generated = runFor(target.role, ctx)
