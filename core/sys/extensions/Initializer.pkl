module bark.extensions.Initializer

extends "Extension.pkl"

import "../GraphModel.pkl" as Sys
class TargetKind {
  role: Sys.PathRole
  schema: Sys.Schema
}

/// Additional files or directories included in the fingerprint.
/// Paths are relative to the extension directory.
fingerprintDeps: List<String> = List()

target: TargetKind

/// How the initializer produces its output.
implementation: Implementation

class InitializerContext {

}

/// Stable identifiers for the implementation kinds, as reported to the CLI.
typealias ImplementationKind = "generator" | "subprocess"

abstract class Implementation {
  abstract fixed kind: ImplementationKind
}

/// Produces files directly.
class Generator extends Implementation {
  fixed kind = "generator"
  generate: (InitializerContext) -> Mapping<String, FileOutput>
}

class Command {
  args: List<String>
  env: Mapping<String, String> = new Mapping {}
}

/// Runs an external command.
class Subprocess extends Implementation {
  fixed kind = "subprocess"
  command: (InitializerContext) -> Command
}
