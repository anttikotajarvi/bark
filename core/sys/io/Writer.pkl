module bark.sys.io.Writer

/// Thin write control layer.
/// A FileOutput is written at `path`; a Mapping is written under it, keyed by subpath.
function write(
  path: String,
  content: FileOutput | Mapping<String, FileOutput>
): Mapping<String, FileOutput> =
  if (content is FileOutput)
    new Mapping { [path] = content }
  else
    content.toMap()
      .mapKeys((subpath, _) -> "\(path)/\(subpath)")
      .toMapping()
