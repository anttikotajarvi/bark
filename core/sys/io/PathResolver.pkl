
/// Path resolution examples:
///
/// Graph declaration              Logical path  File path        File type  Role           Schema
/// ──────────────────────────────────────────────────────────────────────────────────────────────
/// Table(Product)                 products      products         directory  tableDir       Product
/// Table(Product)                 products/P1   products/P1.pkl  file       tableEntry     Product
/// Collection(Index(Product))     lots          lots             directory  collectionDir  null
/// Collection(Index(Product))     lots/L1       lots/L1          directory  indexDir       Product
/// Collection(Table(Product))     groups/G1     groups/G1        directory  tableDir       Product
/// Index(Product)                 fixedProduct  fixedProduct     directory  indexDir       Product
/// Dir(...)                       business      business         directory  dir            null
/// Undeclared path                other         other            null       null           null
///
/// PathRole describes the structural type of the resolved filesystem object.
/// Collection entries inherit the role of their declared entry node.
/// The file path and type follow from the role: only a tableEntry is a file.
module bark.sys.io.PathResolver

import "../GraphModel.pkl" as GraphModel
import "../extensions/Initializers.pkl" as Initializers


/// What a logical path resolves to, as reported to users and the CLI.
abstract class PathInfo {
  /// The requested path in the graph, e.g. "products/P1".
  logicalPath: String

  /// Where the path lands on disk, relative to the data repo root, e.g. "products/P1.pkl".
  filePath: String = if (role != null && GraphModel.isFileRole(role)) "\(logicalPath).pkl" else logicalPath

  /// Whether the path lands on a file or a directory; null for loose paths.
  fileType: FileType? =
    if (role == null) null
    else if (GraphModel.isFileRole(role)) "file"
    else "directory"

  /// Last path segment; null for the graph root.
  name: String?

  /// Structural role of the path; null for loose paths.
  role: GraphModel.PathRole?

  /// Schema associated with this role; null when none applies.
  /// For indexDir and tableEntry, constrains the entry itself.
  /// For tableDir, constrains the files contained by the table.
  schema: GraphModel.Schema?

  /// Initializers whose target matches this path's role and schema.
  initializers: Mapping<String, InitializerInfo> = new {}
}

typealias FileType = "file" | "directory"

/// Limited view of an initializer, as reported to users and the CLI.
class InitializerInfo {
  /// Whether the initializer runs a prepare hook before generating.
  hasPrepare: Boolean

  /// This isnt strictly needed here
  fingerprintDeps: List<String>
}

/// A node explicitly declared in the graph.
class NodePathInfo extends PathInfo {
  node: GraphModel.AnyNode
}

/// An entry contained by a table or collection.
class EntryPathInfo extends PathInfo {
  /// Type of the node holding the entry.
  ownerType: "table-node" | "collection-node"
}

/// A path not declared by the graph.
class LoosePathInfo extends PathInfo {
  /// Type of the parent, if it is a declared node; null otherwise.
  ownerType: GraphModel.NodeType?
}

/// Resolve a logical path (e.g. "lots/L1") against the registry graph.
/// The path does not need to exist on disk.
function resolvePath(graph: GraphModel.AnyNode, declared: Mapping<String, Initializers.Initializer>, path_: String): PathInfo =
  let (segments = pathSegments(path_))
  let (found = GraphModel.getNode(graph, segments))
  let (parent = if (segments.isEmpty) null else GraphModel.getNode(graph, segments.dropLast(1)))
  let (leaf = if (segments.isEmpty) null else segments.last)
    if (parent is GraphModel.CollectionNode && found != null)
      new EntryPathInfo {
        logicalPath = path_
        name = leaf
        ownerType = parent.type
        role = roleOf(found)
        schema = schemaOf(found)
        initializers = matchInitializers(declared, roleOf(found), schemaOf(found))
      }
    else if (parent is GraphModel.TableNode)
      new EntryPathInfo {
        logicalPath = path_
        name = leaf
        ownerType = parent.type
        role = "tableEntry"
        schema = parent._schema
        initializers = matchInitializers(declared, "tableEntry", parent._schema)
      }
    else if (found != null)
      new NodePathInfo {
        logicalPath = path_
        name = leaf
        node = found
        role = roleOf(found)
        schema = schemaOf(found)
        initializers = matchInitializers(declared, roleOf(found), schemaOf(found))
      }
    else
      new LoosePathInfo {
        logicalPath = path_
        name = leaf
        ownerType = parent?.type
        role = null
        schema = null
        initializers = matchInitializers(declared, null, null)
      }

/// Initializers whose target matches the given role and schema.
local function matchInitializers(
  initializers: Mapping<String, Initializers.Initializer>,
  role: GraphModel.PathRole?,
  schema: GraphModel.Schema?
): Mapping<String, InitializerInfo> =
  new Mapping {
    when (role != null && schema != null) {
      for (name, i in initializers) {
        when (i.target.role == role && i.target.schema.path == schema.path) {
          [name] = new InitializerInfo {
            hasPrepare = i.prepare != null
            fingerprintDeps = i.prepare?.fingerprintDeps ?? List()
          }
        }
      }
    }
  }

/// Classify a declared graph node by its filesystem role.
local function roleOf(node: GraphModel.AnyNode): GraphModel.PathRole =
  if (node is GraphModel.DirNode) "dir"
  else if (node is GraphModel.IndexNode) "indexDir"
  else if (node is GraphModel.TableNode) "tableDir"
  else if (node is GraphModel.CollectionNode) "collectionDir"
  else throw("Unknown graph node type: '\(node.type)'")

/// Return the schema associated with a node, if any.
local function schemaOf(node: GraphModel.AnyNode): GraphModel.Schema? =
  if (node is GraphModel.IndexNode) node._schema
  else if (node is GraphModel.TableNode) node._schema
  else null

local function pathSegments(path: String): List<String> =
  if (path.isEmpty || path == ".")
    List()
  else
    let (parts = path.split("/"))
      if (
        path.startsWith("/") ||
        path.contains("\\") ||
        parts.any((p) -> p.isEmpty || p == "." || p == "..")
      )
        throw("Invalid graph path: '\(path)'")
      else
        parts
