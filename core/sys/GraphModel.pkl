import "Generic.pkl" as G

class Schema {
  /// Relative to the .bark directory, where registry.pkl lives.
  path: G.SchemaPath
}

typealias NodeType = "dir-node" | "index-node" | "collection-node" | "table-node"

abstract class AnyNode {
  fixed type: NodeType
}

typealias Children = Mapping<G.PosixDirName, AnyNode>
typealias Graph = AnyNode

class DirNode extends AnyNode {
  fixed type = "dir-node"
  _nodes: Children
}

class TableNode extends AnyNode {
  fixed type = "table-node"
  _schema: Schema
}

class CollectionNode extends AnyNode {
  fixed type = "collection-node"
  _entryNode: AnyNode
}

class IndexNode extends AnyNode {
  fixed type = "index-node"
  _schema: Schema
  _nodes: Children = new Children {}
}

/// Type for naming a filesystem position in relation to the graph.
/// This naming feels sloppy and might to indicate a possible underlying inadequacy of the node system.
typealias PathRole =
  "dir" |
  "indexDir" |
  "tableDir" |
  "collectionDir" |
  "tableEntry"

/// Whether a path with this role is a file (otherwise a directory).
function isFileRole(role: PathRole): Boolean = role == "tableEntry"

/// The graph declaration at the given path segments, or null if the graph declares none.
/// Table entries are not nodes, so they yield null; see `io/PathResolver.pkl`.
function getNode(graph: AnyNode, segments: List<String>): AnyNode? =
  if (segments.isEmpty)
    graph
  else if (graph is CollectionNode)
    getNode(graph._entryNode, segments.drop(1))
  else if (graph is DirNode)
    getChild(graph._nodes, segments)
  else if (graph is IndexNode)
    getChild(graph._nodes, segments)
  else
    null

local function getChild(children: Children, segments: List<String>): AnyNode? =
  let (child = children.getOrNull(segments.first))
    if (child == null) null
    else getNode(child, segments.drop(1))
