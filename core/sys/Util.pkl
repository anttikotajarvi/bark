module bark.Util

import "constants.pkl" as Constants

typealias PklImportPath =
  String(
    !isBlank,
    endsWith(Constants.PKL_EXTENSION)
  )

typealias PklIdentifier =
  String(
    matches(Regex("[A-Za-z_][A-Za-z0-9_]*"))
  )

const function stem(path: String): String =
  path
    .replaceAll(Regex("^.*/"), "")
    .replaceLast(Regex("\\.[^.]*$"), "")

/// Import path from a file in `fromDir` (path segments relative to the data repo root)
/// to `target`, a path relative to the data repo root.
/// From `archive/items` to `.bark/schemas/A.pkl` is "../../.bark/schemas/A.pkl".
function importPathFrom(fromDir: List<String>, target: String): String =
  let (to = target.split("/"))
  let (common = commonLength(fromDir, to.dropLast(1)))
    fromDir.drop(common).map((_) -> "../").join("") + to.drop(common).join("/")

local function commonLength(a: List<String>, b: List<String>): Int =
  if (a.isEmpty || b.isEmpty || a.first != b.first)
    0
  else
    1 + commonLength(a.drop(1), b.drop(1))
