module bark.Util

import "constants.pkl" as Constants

typealias PklImportPath =
  String(
    !isBlank,
    endsWith(Constants.PKL_EXTENSION)
  )

typealias PklIdentifier =
  String(
    matches(Regex("[A-Za-z_][A-Za-z0-9_]*"))
  )

const function stem(path: String): String =
  path
    .replaceAll(Regex("^.*/"), "")
    .replaceLast(Regex("\\.[^.]*$"), "")

