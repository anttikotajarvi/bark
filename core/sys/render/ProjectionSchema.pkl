module bark.render.ProjectionSchema

import "../../Context.pkl" as Context
import "../GraphModel.pkl" as Sys
import "Expr.pkl" as Expr
import "GraphTypes.pkl" as GraphTypes
import "SchemaImports.pkl" as SchemaImports

function render(ctx: Context): String =
  """
  open module ProjectionSchema
  // bark imports
  \(Expr.importAs(ctx.config.coreImport("sys/Generic.pkl"), "G"))

  // User defined schemas
  \(SchemaImports.renderImports(ctx, ctx.graph))

  \(compileTypes(ctx.graph))
  """

// These functions emit fragments tied to this module's fixed root name;
// render is the complete schema-generation operation.
local const ROOT_NAME = "Graph"

local function compileTypes(graph: Sys.AnyNode): String =
  let(rootNode = GraphTypes.nodeType(graph, List(ROOT_NAME)))
  let(rootClass = rootNode.classDecls.filter((c) -> c.name == ROOT_NAME)[0])
    // unroll root class
    """
    \(rootNode.classDecls
      .filter((c) -> c.name != ROOT_NAME) 
      .map((c) ->
        if (c.isOpen)
          Expr.openClassDecl(c.name, c.contents)
        else
          Expr.classDecl(c.name, c.contents)
      )
      .join("\n"))

    \(rootClass.contents.trim())
    """.trim()
