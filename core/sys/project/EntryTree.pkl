module bark.project.EntryTree

import "../constants.pkl" as Constants

typealias NodeName = String

class Entry {
  localPath: String
  importPath: String = localPath
  local els = localPath.split("/")
  fixed anchors: List<String> = els.dropLast(1)
  local filename = els.last
  fixed name: String = filename.replaceLast(Constants.PKL_EXTENSION, "")
}

// Pkl type aliases cannot be recursive, so the functions below own the
// invariant that values in an ENode mapping are themselves ENodes.
typealias ENode = Entry | Mapping<NodeName, Any>

function seed(paths: List<List<String>>): Mapping =
  paths.fold(
    new Mapping {},
    (tree, path) -> seedPath(tree, path)
  )

function addEntries(tree: ENode, entries: List<Entry>): ENode =
  entries.fold(
    tree,
    (result, entry) -> addEntry(result, entry)
  )

function build(entries: List<Entry>): ENode =
  addEntries(new Mapping {}, entries)

// Keep the traversal cursor internal so insertion always starts at the
// anchors derived from the entry's local path.
local function addEntry(tree: ENode, entry: Entry): ENode =
  consumeChild(entry, tree, entry.anchors) ?? tree

// Returns null when the entry cannot be inserted. This lets every caller in
// the recursion reject the change and keep its original node unchanged.
local function consumeChild(
  entry: Entry,
  curNode: ENode,
  curPath: List<String>
): ENode? =
  // index.pkl is a filesystem-level projection boundary. Once a directory is
  // represented by an Entry, descendants lose.
  if (curNode is Entry)
    null
  else if (curPath.isEmpty)
    if (entry.name == Constants.INDEX_NAME)
      entry
    else if (curNode.containsKey(entry.name))
      null
    else
      (curNode) {
        [entry.name] = entry
      }
  else
    let (parentName = curPath.first)
      let (oldChild = (curNode.getOrNull(parentName) ?? new Mapping<NodeName, Any> {}) as ENode)
        let (newChild = consumeChild(entry, oldChild, curPath.drop(1)))
          if (newChild == null)
            null
          else
            (curNode) {
              [parentName] = newChild
            }

local function seedPath(curTree: Mapping, path: List<String>): Mapping =
  if (path.isEmpty)
    curTree
  else
    let (name = path.first)
      let (oldChild = curTree.getOrNull(name) ?? new Mapping {})
        (curTree) {
          [name] = seedPath(oldChild, path.drop(1))
        }
