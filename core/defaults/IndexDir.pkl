/// Default for `indexDir`: an `index.pkl` amending the directory's index schema.
amends "../sys/extensions/DefaultInitializer.pkl"

import "../sys/Util.pkl"

generate = (ctx) -> new Mapping {
  ["index.pkl"] = new FileOutput {
    text = """
      amends "\(Util.importPathFrom(ctx.pathInfo.filePath.split("/"), ctx.pathInfo.schema!!.filePath()))"

      """
  }
}
