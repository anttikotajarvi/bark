/// Initializers used per role when none is named. Repos override a role by
/// amending `defaults` in their context; other roles keep these.
module bark.defaults.Defaults

import "../sys/GraphModel.pkl" as GraphModel
import "../sys/Util.pkl" as Util
import "../sys/extensions/Initializers.pkl" as Initializers

all: Mapping<GraphModel.PathRole, Initializers.DefaultInitializer> = new {
  // An empty entry amending the table's schema.
  // Fill in the schema's required properties after generating.
  ["tableEntry"] {
    generate = (ctx) -> new FileOutput {
      text = """
        amends "\(Util.importPathFrom(ctx.pathInfo.filePath.split("/").dropLast(1), ctx.pathInfo.schema!!.filePath()))"

        """
    }
  }

  // An `index.pkl` amending the directory's index schema.
  ["indexDir"] {
    generate = (ctx) -> new Mapping {
      ["index.pkl"] = new FileOutput {
        text = """
          amends "\(Util.importPathFrom(ctx.pathInfo.filePath.split("/"), ctx.pathInfo.schema!!.filePath()))"

          """
      }
    }
  }
}
