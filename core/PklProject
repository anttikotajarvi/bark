// core/PklProject: the bark core package. Data repos depend on it as `bark` (`@bark/...`).
amends "pkl:Project"
package {
  name = "bark-core"
  baseUri = "package://example.com/bark-core"
  version = "0.1.0"
  packageZipUrl = "https://example.com/bark-core@\(version).zip"
}

evaluatorSettings {
  modulePath {
    "."
  }
}