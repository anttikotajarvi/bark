amends "../sys/postprocess/PostprocessData.pkl"

import "../sys/postprocess/ManifestCoherence.pkl" as ManifestCoherence
import "../sys/postprocess/PreprocessCoherence.pkl" as PreprocessCoherence

local preprocessCoherenceErrors = PreprocessCoherence.check(metadataModule.preprocessErrors)

// Do not force a potentially invalid projection after preprocessing has already
// established that the inputs are incoherent.
local manifestCoherenceErrors =
  if (preprocessCoherenceErrors.isEmpty)
    ManifestCoherence.check(projectionModule, metadataModule.manifestIndex)
  else
    List()

projection = projectionModule
metadata = metadataModule
result = new PostprocessResult {
  errors = preprocessCoherenceErrors + manifestCoherenceErrors
}
