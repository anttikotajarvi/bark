open module bark.scripts.RenderProjectionSchema

extends "pkl:Command"

import "../Context.pkl" as Context
import "../sys/render/ProjectionSchema.pkl" as ProjectionSchema

/// Bark context supplied by the entry point (.bark/render-schema.pkl).
ctx: Context

options: Options

class Options {
  /// Write rendered output to a file instead of stdout.
  @Flag {
    shortName = "o"
    metavar = "file"
    completionCandidates = "paths"
  }
  output: String? = null
}

local generatedHeader =
  """
  // @generated by @bark/scripts/render-schema.pkl; do not edit.
  // Import paths are generated relative to the output directory (\(ctx.outputDir)).
  // They resolve only from there and are not portable without modification.
  // Arguments:
  //   --output=\(options.output ?? "<stdout>")
  //   outputDir=\(ctx.outputDir)
  """.trim()

local rendered =
  """
  \(generatedHeader)

  \(ProjectionSchema.render(ctx))
  """.trim()

output {
  text =
    if (options.output == null)
      rendered
    else
      ""

  files {
    when (options.output != null) {
      ["\(options.output)"] {
        text = rendered
      }
    }
  }
}
