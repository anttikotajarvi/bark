open module bark.scripts.Project

extends "pkl:Command"

import "../Context.pkl" as Context
import "../sys/PathScope.pkl" as PathScope
import "../sys/preprocess/PreprocessData.pkl" as PreprocessData
import "../sys/project/EntryTree.pkl" as EntryTree
import "../sys/project/Projection.pkl" as Projection

/// Bark context supplied by the entry point (.bark/project.pkl).
ctx: Context

/// Preprocess output (projection-meta.pkl), supplied by the entry point.
metadata: PreprocessData

// Pkl entries under the data repo root; PathScope excludes .bark and schema files.
local entries = new Listing<EntryTree.Entry> {
  for (path in ctx.imports.keys.filter((p) -> PathScope.keepProjectLocalPath(p))) {
    new EntryTree.Entry {
      localPath = path
      importPath = ctx.importPathFromOutput(path)
    }
  }
}.toList()

local seededTree = EntryTree.seed(metadata.directoryPaths)
local entryTree = EntryTree.addEntries(seededTree, entries)

options: Options

class Options {
  /// Write the generated Projection.pkl source to a file instead of stdout.
  @Flag {
    shortName = "o"
    metavar = "file"
    completionCandidates = "paths"
  }
  output: String? = null
}

local generatedHeader =
  """
  // @generated by @bark/scripts/project.pkl; do not edit.
  // Import paths are generated relative to the output directory (\(ctx.outputDir)).
  // They resolve only from there and are not portable without modification.
  // Arguments:
  //   --output=\(options.output ?? "<stdout>")
  //   outputDir=\(ctx.outputDir)
  """.trim()

local rendered =
  """
  \(generatedHeader)

  \(Projection.render(entryTree, ctx.graph))
  """.trim()

output {
  text =
    if (options.output == null)
      rendered
    else
      ""

  files {
    when (options.output != null) {
      ["\(options.output)"] {
        text = rendered
      }
    }
  }
}
