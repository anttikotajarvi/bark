open module bark.scripts.InitializerGenerate

extends "pkl:Command"

import "../Context.pkl" as Context
import "../sys/extensions/Initializer.pkl" as Init
import "../sys/extensions/InitializerBase.pkl" as InitBase
import "../sys/extensions/DefaultInitializer.pkl" as DefaultInit
import "../sys/io/PathResolver.pkl" as PathResolver
import "../sys/io/Writer.pkl" as Writer


/// Bark context supplied by the project entrypoint.
ctx: Context

options: Options

class Options {
  /// Logical path relative to the data repository root.
  @Flag {
    completionCandidates = "paths"
  }
  query: String

  /// Name of the initializer, as declared in the registry.
  /// When omitted, the default initializer for the path's role is used.
  initializerName: String?

  /// Raw input made available to the generator, e.g. the prepare hook's output.
  @Flag
  input: String = ""
}

local resolved = PathResolver.resolvePath(ctx.graph, ctx.initializers, options.query)

/// The initializer to use: the named one if given, else the default for the path's role.
local initializer: InitBase =
  let (name = options.initializerName)
    if (name != null)
      if (resolved.initializers.containsKey(name))
        ctx.initializers[name]
      else
        throw("Initializer `\(name)` does not apply to `\(options.query)`. Applicable: \(resolved.initializers.keys.join(", "))")
    else if (resolved.role != null && ctx.defaults.containsKey(resolved.role))
      ctx.defaults[resolved.role]
    else
      throw("No initializer named and no default for role `\(resolved.role)` at `\(options.query)`.")

local initializerContext = new Init.InitializerContext {
  pathInfo = resolved
  config = ctx.config
  input = options.input
}

local generated =
  let (named = options.initializerName)
    if (named != null) (initializer as Init).run(initializerContext)
    else (initializer as DefaultInit).run(resolved.role!!, initializerContext)

output {
  // `pkl run` renders text even when files are set; the default would render ctx.
  text = ""

  files = Writer.write(resolved.filePath, generated)
}
