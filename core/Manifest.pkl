module Manifest

import "sys/constants.pkl" as Constants

typealias ManifestId = String(!isEmpty)

typealias ManifestTargetName = String(
  !contains("/"),
  !isEmpty,
  this != ".",
  this != ".."
)

typealias TagValue = String | Number | Boolean

hidden fixed __bark = Constants.MANIFEST_MARKER

id: ManifestId
target: ManifestTargetName

description: String? = null
tags: Mapping<String, TagValue> = new {}
meta: Any? = null

isDir: Boolean = false
