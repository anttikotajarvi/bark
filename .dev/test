#!/usr/bin/env bash
# Runs each test case in tests/<case>/ as its own bark project.
#
# A case provides repo/ (its data repo files and .bark/registry.pkl, schemas) and
# test.pkl (pkl:test assertions). The runner builds tests/.work/<case>/repo from the
# core's default layout (core/template), tests/_template/PklProject (which depends on
# the local core instead of the published package) and the case's repo/, runs the
# full pipeline there, then runs test.pkl with the pipeline's exit code and output
# as properties.

set -euo pipefail

cd "$(dirname "$0")/.."

PKL=${PKL:-pkl}
TESTS_DIR=tests
WORK_DIR=$TESTS_DIR/.work
ROOT=$(pwd)

readarray -t CASES < <(
  find "$TESTS_DIR" -mindepth 2 -maxdepth 2 -name test.pkl -not -path "$WORK_DIR/*" -print \
    | sed "s#^$TESTS_DIR/##; s#/test.pkl\$##" \
    | sort
)

usage() {
  printf 'usage: ./.dev/test [all|%s]\n' "${CASES[*]}" >&2
}

case_exists() {
  local known
  for known in "${CASES[@]}"; do
    if [ "$known" = "$1" ]; then
      return 0
    fi
  done
  return 1
}

run_case() {
  local name=$1
  local work=$WORK_DIR/$name
  local status

  printf 'test %s\n' "$name"

  rm -rf "$work"
  mkdir -p "$work/repo"
  cp -r core/template/. "$work/repo/"
  cp "$TESTS_DIR/_template/PklProject" "$work/repo/PklProject"
  cp -r "$TESTS_DIR/$name/repo/." "$work/repo/"
  cp "$TESTS_DIR/$name/test.pkl" "$work/test.pkl"

  "$PKL" project resolve "$work/repo" >/dev/null

  # The pipeline may legitimately report errors; assertions decide what is expected.
  set +e
  ./.dev/full-project "$work/repo" >"$work/stdout" 2>"$work/stderr"
  status=$?
  set -e

  "$PKL" test --project-dir "$work/repo" \
    -p "bark.testExitCode=$status" \
    -p "bark.testStdoutPath=file://$ROOT/$work/stdout" \
    -p "bark.testStderrPath=file://$ROOT/$work/stderr" \
    "$work/test.pkl"
}

case_name=${1:-all}

if [ "$case_name" = all ]; then
  for current in "${CASES[@]}"; do
    run_case "$current"
  done
elif case_exists "$case_name"; then
  run_case "$case_name"
else
  usage
  exit 1
fi
