#!/bin/sh

set -eu

PKL=${PKL:-pkl}
CORE_DIR=.bark/core
GENERATED_DIR=$CORE_DIR/generated
INCLUDE_PREFIX=

while [ "$#" -gt 0 ]; do
  case "$1" in
    --include-prefix)
      if [ "$#" -lt 2 ]; then
        echo "error: --include-prefix requires a value" >&2
        exit 1
      fi
      INCLUDE_PREFIX=$2
      shift 2
      ;;
    *)
      echo "error: unknown argument: $1" >&2
      exit 1
      ;;
  esac
done

if [ ! -f .bark/registry.pkl ] || [ ! -f PklProject ]; then
  echo "error: run this script from the data repo root" >&2
  echo "       expected .bark/registry.pkl and PklProject in the current directory" >&2
  echo "       Bark scripts use --module-path ., so modulepath:/ resolves to this root" >&2
  exit 1
fi

mkdir -p "$GENERATED_DIR"

run_pkl() {
  if [ -n "$INCLUDE_PREFIX" ]; then
    "$PKL" run --module-path . -p "bark.includePrefix=$INCLUDE_PREFIX" "$@"
  else
    "$PKL" run --module-path . "$@"
  fi
}

run_pkl "$CORE_DIR/scripts/render-schema.pkl" \
  --output "$GENERATED_DIR/ProjectionSchema.pkl" \
  --path-prefix modulepath:/.bark/

run_pkl "$CORE_DIR/scripts/preprocess.pkl" \
  --output "$GENERATED_DIR/projection-meta.pkl"

run_pkl "$CORE_DIR/scripts/project.pkl" \
  --output "$GENERATED_DIR/projection.pkl" \
  --path-prefix ../../../

"$PKL" eval --module-path . "$GENERATED_DIR/projection-meta.pkl" >/dev/null
"$PKL" eval --module-path . "$GENERATED_DIR/projection.pkl" >/dev/null

run_pkl "$CORE_DIR/scripts/postprocess.pkl" \
  --output "$GENERATED_DIR/postprocess-output.pcf"

echo "Generated and validated projection, metadata, and postprocess artifacts."
