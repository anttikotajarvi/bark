#!/bin/sh

set -eu

PKL=${PKL:-pkl}
BARK_DIR=.bark
SCRIPTS_DIR=$BARK_DIR/scripts
# Must match `config.assumedOutputDir` in .bark/context.pkl: generated imports are relative to it.
OUTPUT_DIR=$BARK_DIR/output

if [ "$#" -gt 1 ]; then
  echo "usage: .dev/full-project [data-repo-root]" >&2
  exit 1
fi

# Data repo root: a path relative to the working directory, defaulting to example/.
ROOT=${1:-$(dirname "$0")/../example}
cd "$ROOT"

if [ ! -f "$BARK_DIR/context.pkl" ] || [ ! -f PklProject ]; then
  echo "error: $ROOT is not a bark data repo" >&2
  echo "       expected $BARK_DIR/context.pkl and PklProject in it" >&2
  exit 1
fi

mkdir -p "$OUTPUT_DIR"

"$PKL" run "$SCRIPTS_DIR/render-schema.pkl" \
  --output "$OUTPUT_DIR/ProjectionSchema.pkl"

"$PKL" run "$SCRIPTS_DIR/preprocess.pkl" \
  --output "$OUTPUT_DIR/projection-meta.pkl"

"$PKL" run "$SCRIPTS_DIR/project.pkl" \
  --output "$OUTPUT_DIR/projection.pkl"

"$PKL" eval "$OUTPUT_DIR/projection-meta.pkl" >/dev/null
"$PKL" eval "$OUTPUT_DIR/projection.pkl" >/dev/null

"$PKL" run "$SCRIPTS_DIR/postprocess.pkl" \
  --output "$OUTPUT_DIR/postprocess-output.pcf"

echo "Generated and validated projection, metadata, and postprocess artifacts."
