#!/bin/sh

set -eu

cd "$(dirname "$0")/.."

GENERATE=.dev/full-project
FIXTURES_DIR=.test-fixtures
GENERATED_DIR=.bark/core/generated

available_fixtures() {
  find "$FIXTURES_DIR" -mindepth 3 -maxdepth 3 -path '*/.bark-test/test.pkl' -print \
    | sed "s#^$FIXTURES_DIR/##; s#/.bark-test/test.pkl\$##" \
    | sort
}

usage() {
  echo "usage: ./.dev/full-fixture <fixture>"
  echo "available fixtures:"
  available_fixtures | sed 's/^/  /'
}

if [ "$#" -ne 1 ]; then
  usage >&2
  exit 1
fi

fixture_name=$1
fixture_dir=$FIXTURES_DIR/$fixture_name

case "$fixture_name" in
  ""|*/*)
    echo "error: unknown fixture: $fixture_name" >&2
    usage >&2
    exit 1
    ;;
esac

if [ ! -f "$fixture_dir/.bark-test/test.pkl" ]; then
  echo "error: unknown fixture: $fixture_name" >&2
  usage >&2
  exit 1
fi

include_prefix=$fixture_dir/repo

echo "Projecting fixture '$fixture_name'."

if [ -d "$include_prefix" ]; then
  BARK_TEST_REGISTRY=$fixture_name BARK_INCLUDE_PREFIX= \
    "$GENERATE" --include-prefix "$include_prefix"
else
  BARK_TEST_REGISTRY=$fixture_name BARK_INCLUDE_PREFIX= \
    "$GENERATE"
fi

echo "Fixture '$fixture_name' generated."
echo "Inspect artifacts under $GENERATED_DIR/."
