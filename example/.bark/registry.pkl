amends "@bark/RegistryDeclaration.pkl" // Required amendment
import "@bark/Meta.pkl" as Meta
import "@bark/sys/extensions/Initializer.pkl" as Initializer



local schemas = new {
  company = Meta.schema("schemas/Company.pkl")
  log = Meta.schema("schemas/Log.pkl")
  lot = Meta.schema("schemas/Lot.pkl")
  product = Meta.schema("schemas/Product.pkl")
}
local defaultGraph =
  Meta.Dir(new Meta.Children {
    ["company"] =
      Meta.IndexedDir(schemas.company, new Meta.Children {
        ["logs"] = Meta.Table(schemas.log)
      })

    ["products"] = Meta.Table(schemas.product)

    ["lots"] = Meta.Collection(Meta.Index(schemas.lot))

    ["archive"] =
      Meta.Dir(new Meta.Children {
        ["discontinued-products"] = Meta.Table(schemas.product)
        ["recalled-products"] = Meta.Table(schemas.product)
        ["by-year"] =
          Meta.Dir(new Meta.Children {
            ["2024"] = Meta.Table(schemas.product)
            ["2025"] = Meta.Table(schemas.product)
          })
      })
  })

graph = defaultGraph

initializers {
  ["init-product"] = (Initializer) {
    target {
      role = "tableEntry"
      schema = schemas.product
    }
    implementation = new Meta.Subprocess {
      command = (_) -> new Meta.Command { args = List("echo", "init product") }
    }
  }
  ["gen-product"] = (Initializer) {
    target {
      role = "tableEntry"
      schema = schemas.product
    }
    implementation = new Meta.Generator { generate = (_) -> new Mapping {
      ["new-product.pkl"] = new FileOutput {
        text = """
          amends "schema.pkl"

          id = "NEW-PRODUCT"
          description = ""
          stock_qty = 0

          """
      }
    } }
  }
}
