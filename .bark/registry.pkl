amends "core/RegistryDeclaration.pkl" // Required amendment
import "core/src/Meta.pkl" as Lib
import "core/src/Scaffolding.pkl" as Sys

local schemas = new {
  company = Lib.schema("schemas/Company.pkl")
  log = Lib.schema("schemas/Log.pkl")
  lot = Lib.schema("schemas/Lot.pkl")
  product = Lib.schema("schemas/Product.pkl")
}
graph =
  Lib.Dir(new Sys.Children {
    ["company"] =
      Lib.IndexedDir(schemas.company, new Sys.Children {
        ["logs"] = Lib.Table(schemas.log)
      })

    ["products"] = Lib.Table(schemas.product)

    ["lots"] = Lib.Collection(Lib.Index(schemas.lot))

    ["archive"] =
      Lib.Dir(new Sys.Children {
        ["discontinued-products"] = Lib.Table(schemas.product)
        ["recalled-products"] = Lib.Table(schemas.product)
        ["by-year"] =
          Lib.Dir(new Sys.Children {
            ["2024"] = Lib.Table(schemas.product)
            ["2025"] = Lib.Table(schemas.product)
          })
      })
  })
