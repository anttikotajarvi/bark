amends "@bark/RegistryDeclaration.pkl" // Required amendment
import "@bark/src/Meta.pkl" as Lib
import "@bark/src/Scaffolding.pkl" as Sys

local schemas = new {
  company = Lib.schema("bundle/schemas/Company.pkl")
  log = Lib.schema("bundle/schemas/Log.pkl")
  lot = Lib.schema("bundle/schemas/Lot.pkl")
  product = Lib.schema("bundle/schemas/Product.pkl")
}
graph = Lib.Dir(new Sys.Children {
  ["company"] = Lib.IndexedDir(schemas.company, new Sys.Children {
    ["logs"] = Lib.Table(schemas.log)
  })

  ["products"] = Lib.Table(schemas.product)

  ["lots"] = Lib.Collection(
    Lib.Index(schemas.lot)
  )

  ["archive"] = Lib.Dir(new Sys.Children {
    ["old-products"] = Lib.Table(schemas.product)
    ["test-products"] = Lib.Table(schemas.product)
    ["nested"] = Lib.Dir(new Sys.Children {
      ["nested-old-products"] = Lib.Table(schemas.product)
      ["nested-test-products"] = Lib.Table(schemas.product)
  })
  })
})
