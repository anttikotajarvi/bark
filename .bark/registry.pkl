amends "core/RegistryDeclaration.pkl" // Required amendment
import "core/Meta.pkl" as Meta

local schemas = new {
  company = Meta.schema("schemas/Company.pkl")
  log = Meta.schema("schemas/Log.pkl")
  lot = Meta.schema("schemas/Lot.pkl")
  product = Meta.schema("schemas/Product.pkl")
}
graph =
  Meta.Dir(new Meta.Children {
    ["company"] =
      Meta.IndexedDir(schemas.company, new Meta.Children {
        ["logs"] = Meta.Table(schemas.log)
      })

    ["products"] = Meta.Table(schemas.product)

    ["lots"] = Meta.Collection(Meta.Index(schemas.lot))

    ["archive"] =
      Meta.Dir(new Meta.Children {
        ["discontinued-products"] = Meta.Table(schemas.product)
        ["recalled-products"] = Meta.Table(schemas.product)
        ["by-year"] =
          Meta.Dir(new Meta.Children {
            ["2024"] = Meta.Table(schemas.product)
            ["2025"] = Meta.Table(schemas.product)
          })
      })
  })
