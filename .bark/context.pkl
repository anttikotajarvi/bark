// Bark context. Generated once by the core initializer; edit freely.
// Globs and `read` resolve relative to this file, which is why they live here.
amends "@bark/Context.pkl"

// Every Pkl file in the data repo. Narrow this glob to scope what bark can see.
imports = import*("../**.pkl")

graph = import("registry.pkl").graph

readFile = (path) -> read?("../\(path)")
