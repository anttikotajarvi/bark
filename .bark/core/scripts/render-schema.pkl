module bark.scripts.RenderProjectionSchema

extends "pkl:Command"

import "../../registry.pkl" as Registry
import "../sys/PathScope.pkl" as PathScope
import "../sys/constants.pkl" as CFG
import "../sys/render/ProjectionSchema.pkl" as ProjectionSchema

const DEFAULT_PATH_PREFIX = CFG.BARK_MODULEPATH_PREFIX

options: Options

class Options {
  /// Write rendered output to a file instead of stdout.
  @Flag {
    shortName = "o"
    metavar = "file"
    completionCandidates = "paths"
  }
  output: String? = null

  /// Prefix prepended to graph-declared schema import paths.
  /// Include a trailing slash when the prefix is not empty.
  @Flag { metavar = "path" }
  `path-prefix`: String? = null
}

local PATH_PREFIX = options.`path-prefix` ?? DEFAULT_PATH_PREFIX
local INCLUDE_PREFIX = PathScope.includePrefix()

local generatedHeader =
  """
  // @generated by .bark/core/scripts/render-schema.pkl; do not edit.
  // Arguments:
  //   --output=\(options.output ?? "<stdout>")
  //   --path-prefix=\(PATH_PREFIX)
  //   -p \(CFG.INCLUDE_PREFIX_NAME)=\(INCLUDE_PREFIX)
  """.trim()

rendered =
  """
  \(generatedHeader)

  \(ProjectionSchema.render(Registry.graph, PATH_PREFIX))
  """.trim()

output {
  text =
    if (options.output == null)
      rendered
    else
      ""

  files {
    when (options.output != null) {
      ["\(options.output)"] {
        text = rendered
      }
    }
  }
}
