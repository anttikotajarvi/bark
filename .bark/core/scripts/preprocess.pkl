module bark.scripts.Preprocess

extends "pkl:Command"

import "preprocess-data.pkl" as Data

const PREPROCESS_SCHEMA_PATH = "modulepath:/.bark/core/src/preprocess/PreprocessData.pkl"

options: Options

class Options {
  /// Write generated projection metadata source to a file instead of stdout.
  @Flag {
    shortName = "o"
    metavar = "file"
    completionCandidates = "paths"
  }
  output: String? = null
}

local renderedBody = output.renderer.renderDocument(Data)

local generatedHeader =
  """
  // @generated by .bark/core/scripts/preprocess.pkl; do not edit.
  // Arguments:
  //   --output=\(options.output ?? "<stdout>")
  """.trim()

rendered =
  """
  \(generatedHeader)

  amends "\(PREPROCESS_SCHEMA_PATH)"

  \(renderedBody)
  """.trim()

output {
  text = if (options.output == null) rendered else ""

  files {
    when (options.output != null) {
      ["\(options.output)"] {
        text = rendered
      }
    }
  }
}
