amends "../sys/postprocess/PostprocessData.pkl"

import "../generated/projection.pkl" as Projection
import "../generated/projection-meta.pkl" as Metadata
import "../sys/postprocess/ManifestCoherence.pkl" as ManifestCoherence

local manifestCoherence =
  ManifestCoherence.check(Projection, Metadata.manifestIndex)

// Local properties are lazy, so make the rendered projection force the check.
projection =
  if (manifestCoherence)
    Projection
  else
    throw("Manifest coherence check failed")

metadata = Metadata
