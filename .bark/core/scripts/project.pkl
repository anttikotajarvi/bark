module bark.scripts.Project

extends "pkl:Command"

import "../../registry.pkl" as Registry
import "../generated/projection-meta.pkl" as Metadata
import "../sys/project/EntryTree.pkl" as EntryTree
import "../sys/project/Projection.pkl" as Projection


const ROOT_PATH = "../../../"                 // these need to be coupled 
local allImports = import*("../../../**.pkl") // <---

local entries = new Listing<EntryTree.Entry> {
  for (path in allImports.keys.filter((p) -> keepImportPath(p))) {
    new EntryTree.Entry {
      localPath = path.replaceFirst(ROOT_PATH, "")
    }
  }
}.toList()

local seededTree = EntryTree.seed(Metadata.directoryPaths)
local entryTree = EntryTree.addEntries(seededTree, entries)
local PATH_PREFIX = options.`path-prefix` ?? ROOT_PATH

options: Options

class Options {
  /// Write the generated Projection.pkl source to a file instead of stdout.
  @Flag {
    shortName = "o"
    metavar = "file"
    completionCandidates = "paths"
  }
  output: String? = null

  /// Prefix prepended to entry paths in generated import expressions.
  /// Include a trailing slash when the prefix is not empty.
  @Flag { metavar = "path" }
  `path-prefix`: String? = null
}

local generatedHeader =
  """
  // @generated by .bark/core/scripts/project.pkl; do not edit.
  // Arguments:
  //   --output=\(options.output ?? "<stdout>")
  //   --path-prefix=\(PATH_PREFIX)
  """.trim()

rendered =
  """
  \(generatedHeader)

  \(Projection.render(entryTree, Registry.graph, PATH_PREFIX))
  """.trim()

output {
  text =
    if (options.output == null)
      rendered
    else
      ""

  files {
    when (options.output != null) {
      ["\(options.output)"] {
        text = rendered
      }
    }
  }
}

local function keepImportPath(path: String): Boolean =
  !path.startsWith("../../.bark/") &&
  !path.contains("/.bark/") &&
  !path.endsWith("/index-schema.pkl") &&
  !path.endsWith("/schema.pkl")
