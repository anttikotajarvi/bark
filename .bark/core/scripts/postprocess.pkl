module bark.scripts.Postprocess

extends "pkl:Command"

import "postprocess-data.pkl" as Data

options: Options

class Options {
  /// Write postprocess output to a file instead of stdout.
  @Flag {
    shortName = "o"
    metavar = "file"
    completionCandidates = "paths"
  }
  output: String? = null
}

output {
  value = Data
  text = if (options.output == null) super.text else ""

  files {
    when (options.output != null) {
      ["\(options.output)"] {
        value = Data
      }
    }
  }
}
