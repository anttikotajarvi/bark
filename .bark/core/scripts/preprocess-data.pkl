amends "../sys/preprocess/PreprocessData.pkl"

import "../../registry.pkl" as Registry
import "../sys/PathScope.pkl" as PathScope
import "../sys/constants.pkl" as CFG
import "../sys/preprocess/ManifestIndex.pkl" as ManifestIndex
import "../sys/project/DirectoryShape.pkl" as DirectoryShape

// Path from .bark/core/scripts back to the data repo root.
local const ROOT_PATH = "../../../"

// Scan manifest files under the data repo root; ManifestIndex excludes .bark.
local allManifestImports = import*("../../../**.manifest.pkl")

manifestIndex = ManifestIndex.build(
  ROOT_PATH,
  allManifestImports,
  (path) -> targetExists(path)
)

directoryPaths = DirectoryShape.requireDirectoryShape(
  Registry.graph,
  (path) -> directoryResource(path) != null,
  (path) -> directoryChildren(path),
  "project root is '\(ROOT_PATH)' relative to preprocess-data.pkl; \(CFG.INCLUDE_PREFIX_ENV_VAR) is '\(CFG.INCLUDE_PREFIX)'"
)

local function directoryResource(path: List<String>): Resource? =
  read?(PathScope.physicalPathFromSegments(ROOT_PATH, path))

local function directoryChildren(path: List<String>): List<String> =
  let (resource = directoryResource(path))
    if (resource == null)
      List()
    else
      resource.text
        .split("\n")
        .filter((name) -> !name.isBlank)
        .filter((name) -> PathScope.keepDirectoryChild(path, name))

local function targetExists(path: String): Boolean =
  read?("\(ROOT_PATH)\(path)") != null
