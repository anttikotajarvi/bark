module bark.preprocess.ManifestIndex

import "../constants.pkl" as CFG
import "../Errors.pkl" as Errors
import "../PathScope.pkl" as PathScope

class ManifestIndexEntry {
  manifestPath: String
  targetPath: String
  target: String
  isDir: Boolean
}

typealias ManifestIndex = Mapping<String, ManifestIndexEntry>
typealias TargetExists = (String) -> Boolean

/// Derives the target name dictated by a manifest sidecar's filename.
const function expectedTargetName(localPath: String): String =
  localPath
    .split("/")
    .last
    .replaceLast(CFG.MANIFEST_SUFFIX, "")

function build(
  rootPath: String,
  imports: Mapping<String, Any>,
  targetExists: TargetExists
): ManifestIndex =
  recordsToIndex(validateRecords(targetExists, buildRecords(rootPath, imports)))

// Transient records and validation stages are owned by build. They must not be
// exposed as independently overridable ways to construct an unchecked index.
local class ManifestRecord {
  importPath: String
  localPath: String
  physicalLocalPath: String
  manifest: Any
  expectedTarget: String
  targetPath: String
  physicalTargetPath: String
}

local class ManifestImport {
  importPath: String
  localPath: String
  physicalLocalPath: String
}

local function parentPath(localPath: String): String =
  localPath
    .split("/")
    .dropLast(1)
    .join("/")

local function targetPath(localPath: String, target: String): String =
  let (parent = parentPath(localPath))
    if (parent == "") target else "\(parent)/\(target)"

local function buildRecords(
  rootPath: String,
  imports: Mapping<String, Any>
): List<ManifestRecord> =
  let (manifestImports = new Listing<ManifestImport> {
    for (path in imports.keys) {
      for (scoped in PathScope.scopedPaths(rootPath, path).filter((p) -> PathScope.keepUserLocalPath(p.localPath))) {
        new ManifestImport {
          importPath = path
          localPath = scoped.localPath
          physicalLocalPath = scoped.physicalLocalPath
        }
      }
    }
  }.toList())
    new Listing<ManifestRecord> {
      for (entry in manifestImports) {
        let (expected = expectedTargetName(entry.localPath))
          new ManifestRecord {
            importPath = entry.importPath
            localPath = entry.localPath
            physicalLocalPath = entry.physicalLocalPath
            manifest = imports[entry.importPath]
            expectedTarget = expected
            targetPath = targetPath(entry.localPath, expected)
            physicalTargetPath = targetPath(entry.physicalLocalPath, expected)
          }
        }
    }.toList()

local function validateSidecar(rec: ManifestRecord): ManifestRecord =
  if (rec.manifest.target != rec.expectedTarget)
    Errors.manifestSidecarMismatch(
      rec.localPath,
      rec.expectedTarget,
      rec.manifest.target
    )
  else
    rec

local function validateTargetExists(targetExists: TargetExists, rec: ManifestRecord): ManifestRecord =
  if (!targetExists.apply(rec.physicalTargetPath))
    Errors.manifestTargetMissing(rec.localPath, rec.targetPath)
  else
    rec

local function duplicateIds(records: List<ManifestRecord>): List<String> =
  records
    .map((rec) -> rec.manifest.id)
    .filter((id) -> records.filter((rec) -> rec.manifest.id == id).length > 1)
    .distinct

local function validateUniqueIds(records: List<ManifestRecord>): List<ManifestRecord> =
  let (dupes = duplicateIds(records))
    if (!dupes.isEmpty)
      Errors.duplicateManifestIds(dupes)
    else
      records

local function validateRecords(
  targetExists: TargetExists,
  records: List<ManifestRecord>
): List<ManifestRecord> =
  validateUniqueIds(
    records
      .map((rec) -> validateSidecar(rec))
      .map((rec) -> validateTargetExists(targetExists, rec))
  )

local function recordsToIndex(records: List<ManifestRecord>): ManifestIndex =
  new Mapping<String, ManifestIndexEntry> {
    for (rec in records) {
      [rec.manifest.id] = new ManifestIndexEntry {
        manifestPath = rec.localPath
        targetPath = rec.targetPath
        target = rec.manifest.target
        isDir = rec.manifest.isDir
      }
    }
  }
