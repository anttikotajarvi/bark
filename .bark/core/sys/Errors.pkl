module bark.Errors

function missingRequiredDirectories(
  paths: List<List<String>>,
  extraInfo: String?
): nothing =
  let (pathList = paths
    .map((path) -> "- \(path.join("/"))")
    .join("\n"))
  let (context =
    if (extraInfo == null || extraInfo.isBlank)
      ""
    else
      "\n\nContext: \(extraInfo)")
    throw(
      """
      Missing required project directories:
      \(pathList)\(context)
      """.trim()
    )

function manifestSidecarMismatch(
  manifestPath: String,
  expectedTarget: String,
  actualTarget: String
): nothing =
  throw(
    """
    Manifest sidecar mismatch.

    Manifest:
      \(manifestPath)

    Expected target:
      \(expectedTarget)

    Actual target:
      \(actualTarget)
    """.trim()
  )

function manifestTargetMissing(
  manifestPath: String,
  targetPath: String
): nothing =
  throw(
    """
    Manifest target missing.

    Manifest:
      \(manifestPath)

    Expected target:
      \(targetPath)
    """.trim()
  )

function duplicateManifestIds(ids: List<String>): nothing =
  throw(
    """
    Duplicate manifest ids:
    \(ids.map((id) -> "- \(id)").join("\n"))
    """.trim()
  )


// noinspection UnresolvedElement
function projectedManifestIdsMissing(refs: List<Any>): nothing =
  throw(
    """
    Projected manifest values missing from manifest index:
    \(refs.map((ref) -> "- \(ref.id) at \(if (ref.path == "") "(root)" else ref.path)").join("\n"))
    """.trim()
  )
