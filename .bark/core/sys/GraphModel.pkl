import "Generic.pkl" as G

class Schema {
  path: G.SchemaPath
  /// Bark scripts require modulepath:/ to resolve to the data repo root.
  hidden PATH_OFFSET = "modulepath:/.bark/"
  resource: Resource|String = read(PATH_OFFSET+path)
}

abstract class AnyNode {
  fixed type: String
}

typealias Children = Mapping<G.PosixDirName, AnyNode>
typealias Graph = AnyNode

class DirNode extends AnyNode {
  fixed type = "dir-node"
  _nodes: Children
}

class TableNode extends AnyNode {
  fixed type = "table-node"
  _schema: Schema
}

class CollectionNode extends AnyNode {
  fixed type = "collection-node"
  _entryNode: AnyNode
}

class IndexNode extends AnyNode {
  fixed type = "index-node"
  _schema: Schema
  _nodes: Children = new Children {}
}
