module bark.postprocess.SpecialValues

import "../constants.pkl" as CFG
import "ValueWalk.pkl" as ValueWalk

function hasMarker(value: Any, marker: String): Boolean =
  ValueWalk.isObjectLike(value) &&
  value.hasProperty(CFG.BARK_MARKER_FIELD) &&
  value.getPropertyOrNull(CFG.BARK_MARKER_FIELD) == marker

function isManifest(value: Any): Boolean =
  hasMarker(value, CFG.MANIFEST_MARKER)
